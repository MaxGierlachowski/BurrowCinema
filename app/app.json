{
  "expo": {
    "name": "BurrowCinema",
    "slug": "burrowcinema",
    "version": "0.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "burrowcinema",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#110d0a",
    "android": {
      "package": "app.burrowcinema",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#f3bd5c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.burrowcinema",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "react-native-video",
        {
          "enableAndroidPictureInPicture": true,
          "enableNotificationControls": false,
          "enableBackgroundAudio": false
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/images/tv-banner.png"
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#f3bd5c"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110d0a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "# WorkManager (used by expo-background-task) creates its Room database by reflection;\n# without these rules R8 removes the constructor and the app crashes before it starts.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n# react-native-video und Media3: Renderer, Extractor und MediaSource Factories werden teils per Reflection geladen.\n-keep class com.brentvatne.** { *; }\n-keep class androidx.media3.** { *; }\n-dontwarn androidx.media3.**\n-dontwarn com.google.ads.interactivemedia.**\n# Google Cast: the options provider is loaded by name from the manifest\n-keep class com.reactnative.googlecast.** { *; }"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Geist_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Geist_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Geist_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Geist_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Geist_400Regular.ttf",
              "./assets/fonts/Geist_500Medium.ttf",
              "./assets/fonts/Geist_600SemiBold.ttf",
              "./assets/fonts/Geist_700Bold.ttf"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withCrashLog",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "expandedController": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "tsconfigPaths": false
    }
  }
}
